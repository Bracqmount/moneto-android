<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fond de base sombre -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F1117" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Dégradé subtil du haut vers le bas -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#221A1F2E"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Dégradé subtil doré en haut -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18F59E0B"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Bordure -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1F2937" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>